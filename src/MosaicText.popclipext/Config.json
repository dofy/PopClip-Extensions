  "keywords": "mosaic redact privacy censor",
  "options": [
    {
      "identifier": "mosaic-code",
      "label": {
        "en": "Mosaic Code",
        "zh-hans": "马赛克代码",
        "zh-hant": "馬賽克代碼",
        "ja": "モザイクコード",
        "ko": "모자이크 문자",
        "fr": "Caractère de mosaïque",
        "es": "Carácter de mosaico"
      },
      "type": "string",
      "inset": true,
      "defaultValue": "*"
    }
  ],
  "actions": [
    {
      "identifier": "Mosaic",
      "title": {
        "en": "Mosaic",
        "zh-hans": "打马赛克",
        "zh-hant": "打馬賽克",
        "ja": "モザイク",
        "ko": "모자이크",
        "fr": "Mosaïque",
        "es": "Mosaico"
      },
      "javascript-file": "mosaic.js"
    }
  ]
