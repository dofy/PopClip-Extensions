{
  "identifier": "xyz.phpz.popclip.extension.mosaic-text",
  "icon": "iconify:mingcute:mosaic-line",
  "version": 1,
  "popclipVersion": 6159,
  "name": {
    "en": "Mosaic Text",
    "zh-hans": "马赛克文本",
    "zh-hant": "馬賽克文本",
    "ja": "モザイクテキスト",
    "ko": "모자이크 텍스트",
    "fr": "Texte en mosaïque",
    "es": "Texto en mosaico"
