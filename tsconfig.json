{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@popclip/types"],
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "templates/module/Main.ts",
    "templates/_Snippets/template.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
